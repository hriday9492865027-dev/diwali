# Neon Serverless PostgreSQL (Injected by Vercel Marketplace or manual connection)
DATABASE_URL="postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage Token (Private Store)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_SampleTokenPlaceholder"

# Application Session Secret (At least 32 characters random string)
AUTH_SECRET="your-secure-random-32-character-secret-key-change-in-prod"

# Administrator Initial Bootstrap Credentials
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# Node Environment
NODE_ENV="development"

